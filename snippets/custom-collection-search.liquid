<script src="{{ 'custom-collection-search.js' | asset_url }}" defer="defer"></script>

<div class="collection-search" data-collection-search>
  <form action="{{ routes.search_url }}" method="get" role="search" class="collection-search__form">
    <input type="hidden" name="type" value="product">
    <input
      type="search"
      name="q"
      class="collection-search__input"
      placeholder="Search products"
      aria-label="Search products"
      autocomplete="off"
      data-collection-search-input
    >
    <button type="submit" class="collection-search__submit" aria-label="Search">
      <img src="{{ 'search-icon.svg' | asset_url }}" width="17" height="17" alt="Search icon">
    </button>
  </form>

  <ul class="collection-search__results" data-collection-search-results hidden></ul>
</div>

{% stylesheet %}
  .collection-search {
    display: flex;
    margin-bottom: 1rem;
    border-bottom: 2px solid #0d0d0d;
  }

  .collection-search__form {
    display: flex;
    align-items: center;
    border: 1px solid var(--color-border, #ddd);
    border-radius: 4px;
    padding: 6px 10px;
  }

  .collection-search__input {
    border: none;
    outline: none;
    flex: 1;
    font: inherit;
    background: transparent !important;
    padding: 8px;
  }

  .collection-search__submit {
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
  }

  .collection-search__results {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    z-index: 10;
    background: var(--color-background, #fff);
    border: 1px solid var(--color-border, #ddd);
    border-radius: 4px;
    margin-top: 4px;
    max-height: 320px;
    overflow-y: auto;
    list-style: none;
    padding: 0;
  }

  .collection-search__result-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    text-decoration: none;
    color: inherit;
  }

  .collection-search__result-link:hover,
  .collection-search__result-link:focus {
    background: var(--color-background-alt, #f5f5f5);
  }

  .collection-search__result-image {
    border-radius: 2px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .collection-search__result-info {
    display: flex;
    flex-direction: column;
    font-size: 0.9rem;
  }

  .collection-search__result-price {
    color: var(--color-foreground-secondary, #666);
  }

  .collection-search__empty {
    padding: 10px;
    font-size: 0.9rem;
    color: var(--color-foreground-secondary, #666);
  }
{% endstylesheet %}
