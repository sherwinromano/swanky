{%- liquid
  assign block_count = section.blocks.size
-%}

{% style %}
  .insta-feed {
    overflow: hidden;
    max-width: 1200px;
    margin: 0 auto;
    padding-inline: 15px;
  }

  .insta-feed__inner {
    max-width: 100%;
    margin-inline: auto;
  }

  .insta-feed__heading-link {
    text-decoration: none;
    display: block;
  }

  .insta-feed__heading {
    margin: 0 0 24px;
    text-align: center;
    color: #040404;
    font-size: 1.75rem;
    line-height: 1.2;
  }

  .insta-feed__grid {
    display: flex;
    flex-direction: column;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 20px;
  }

  .insta-feed__item {
    width: 100%;
  }

  .insta-feed__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .insta-feed__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -4px;
  }

  .insta-feed__media {
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    background-color: #e9e2da;
  }

  .insta-feed__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .insta-feed__image--placeholder {
    object-fit: contain;
    padding: 24px;
  }

  .insta-feed__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #00000080;
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }

  .insta-feed__icon {
    width: 32px;
    height: 32px;
    color: #ffffff;
  }

  /* Reveal overlay on hover / keyboard focus of the link that wraps the media */
  .insta-feed__link:hover .insta-feed__overlay,
  .insta-feed__link:focus-visible .insta-feed__overlay {
    opacity: 1;
  }

  /* If a block has no link, still allow hover reveal directly on the media */
  .insta-feed__item:has(> .insta-feed__media):hover .insta-feed__overlay {
    opacity: 1;
  }

  @media (min-width: 768px) {
    .insta-feed__heading {
      font-size: 2.25rem;
      margin-bottom: 32px;
    }

    .insta-feed__icon {
      width: 40px;
      height: 40px;
    }
  }

  @media (min-width: 1024px) {
    .insta-feed__grid {
      flex-direction: row;
    }

    .insta-feed__item {
      flex: 1 1 20%;
      max-width: 20%;
    }

    .insta-feed__heading {
      font-size: 2.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .insta-feed__overlay {
      transition: none;
    }
  }
{% endstyle %}

<section
  class="insta-feed"
  id="insta-feed-{{ section.id }}"
  aria-labelledby="insta-feed-heading-{{ section.id }}"
>
  <div class="insta-feed__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="insta-feed__heading" id="insta-feed-heading-{{ section.id }}">
        {{ section.settings.heading | escape }}
      </h2>
    {% else %}
      <h2 class="insta-feed__heading" id="insta-feed-heading-{{ section.id }}">Shop Our Insta</h2>
    {%- endif -%}

    {%- if block_count > 0 -%}
      <ul class="insta-feed__grid" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign img = block.settings.image
            assign has_link = false
            if block.settings.link != blank
              assign has_link = true
            endif
            assign a11y_label = block.settings.alt | default: 'Shop this look on Instagram'
          -%}
          <li class="insta-feed__item" {{ block.shopify_attributes }}>
            {%- if has_link -%}
              <a
                href="{{ block.settings.link }}"
                class="insta-feed__link"
                aria-label="{{ a11y_label | escape }}"
                {% if block.settings.open_in_new_tab %}
                  target="_blank" rel="noopener noreferrer"
                {% endif %}
              >
            {%- endif -%}

            <span class="insta-feed__media">
              {%- if img != blank -%}
                <img
                  class="insta-feed__image"
                  src="{{ img | image_url: width: 800 }}"
                  srcset="
                    {{ img | image_url: width: 400 }} 400w,
                    {{ img | image_url: width: 600 }} 600w,
                    {{ img | image_url: width: 800 }} 800w,
                    {{ img | image_url: width: 1200 }} 1200w
                  "
                  sizes="(min-width: 1024px) 20vw, 100vw"
                  alt="{{ img.alt | default: a11y_label | escape }}"
                  width="{{ img.width }}"
                  height="{{ img.height }}"
                  loading="lazy"
                  decoding="async"
                >
              {%- else -%}
                {%- comment -%}
                  Fallback content: replace 'insta-feed-placeholder.jpg' below with
                  your own asset uploaded to this theme's /assets folder.
                {%- endcomment -%}
                <svg
                  class="insta-feed__image insta-feed__image--placeholder"
                  viewBox="0 0 800 800"
                  role="img"
                  aria-label="{{ 'Instagram placeholder image' | escape }}"
                  width="800"
                  height="800"
                >
                  <rect width="800" height="800" fill="#e9e2da" />
                  <rect x="120" y="140" width="560" height="520" rx="28" fill="#f5efe9" stroke="#d2c5b9" stroke-width="8" />
                  <circle cx="400" cy="330" r="120" fill="#d7cdbd" />
                  <path d="M270 600c40-90 120-140 220-140 70 0 135 28 170 76" fill="none" stroke="#b8a592" stroke-width="18" stroke-linecap="round" />
                </svg>
              {%- endif -%}

              <span class="insta-feed__overlay" aria-hidden="true">
                <svg
                  class="insta-feed__icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                  focusable="false"
                >
                  <rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="2"/>
                  <circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="2"/>
                  <circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"/>
                </svg>
              </span>
            </span>

            {%- if has_link -%}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop Our Insta",
  "tag": "section",
  "class": "section-shop-our-insta",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop Our Insta"
    }
  ],
  "blocks": [
    {
      "type": "image_block",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Where this image links to, e.g. an Instagram post or product."
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Accessibility label",
          "info": "Describes this image for screen reader users."
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Shop Our Insta",
      "category": "Custom sections",
      "settings": {},
      "blocks": [
        { "type": "image_block" },
        { "type": "image_block" },
        { "type": "image_block" },
        { "type": "image_block" },
        { "type": "image_block" }
      ]
    }
  ]
}
{% endschema %}
