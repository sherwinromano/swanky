<section
  class="article-grid{% if section.settings.section_padding_top %} article-grid--pt{% endif %}"
  id="article-grid-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-per-page="{{ section.settings.items_per_page }}"
  style="
    --agrid-columns-desktop: {{ section.settings.columns_desktop }};
    --agrid-columns-tablet: {{ section.settings.columns_tablet }};
    --agrid-gap: {{ section.settings.grid_gap }}px;
    --agrid-title-color: {{ section.settings.heading_color }};
    --agrid-card-title-color: {{ section.settings.card_title_color }};
    --agrid-card-text-color: {{ section.settings.card_text_color }};
    --agrid-accent-color: {{ section.settings.accent_color }};
    --agrid-arrow-color: {{ section.settings.arrow_color }};
    --agrid-arrow-bg: {{ section.settings.arrow_bg_color }};
    --agrid-dot-color: {{ section.settings.dot_color }};
    --agrid-dot-active-color: {{ section.settings.dot_active_color }};
  "
>
  <div class="article-grid__container page-width">
    {% if section.blocks.size > 0 %}
      <div class="article-grid__viewport">
        <div class="article-grid__track" data-agrid-track>
          <div class="article-grid__page" data-agrid-page>
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'card' %}
                  <article class="article-card" data-agrid-item {{ block.shopify_attributes }}>
                    {% if block.settings.image != blank %}
                      <a
                        href="{{ block.settings.link | default: '#' }}"
                        class="article-card__image-wrap"
                        {% if block.settings.link == blank %}
                          tabindex="-1" aria-hidden="true"
                        {% endif %}
                      >
                        {{
                          block.settings.image
                          | image_url: width: 800
                          | image_tag:
                            class: 'article-card__image',
                            loading: 'lazy',
                            widths: '400,600,800,1000',
                            sizes: '(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw'
                        }}
                      </a>
                    {% else %}
                      <div class="article-card__image-wrap article-card__image-wrap--placeholder">
                        {{ 'image' | placeholder_svg_tag: 'article-card__image article-card__placeholder-svg' }}
                      </div>
                    {% endif %}

                    <div class="article-card__content">
                      {% if block.settings.title != blank %}
                        <h3 class="article-card__title">
                          {% if block.settings.link != blank %}
                            <a href="{{ block.settings.link }}" class="article-card__title-link">
                              {{ block.settings.title }}
                            </a>
                          {% else %}
                            {{ block.settings.title }}
                          {% endif %}
                        </h3>
                      {% endif %}

                      {% if block.settings.text != blank %}
                        <div class="article-card__text">{{ block.settings.text }}</div>
                      {% endif %}
                    </div>
                  </article>
              {% endcase %}
            {% endfor %}
          </div>
        </div>
      </div>

      {% if section.settings.show_pagination and section.blocks.size > 1 %}
        <div class="article-grid__pagination" data-agrid-pagination>
          <button
            type="button"
            class="article-grid__arrow article-grid__arrow--prev"
            data-agrid-prev
            aria-label="Previous"
          >
            <img src="{{ 'chevron-left.svg' | asset_url }}" width="25" height="40" alt="Chevron left" />
          </button>

          <div class="article-grid__dots" data-agrid-dots></div>

          <button
            type="button"
            class="article-grid__arrow article-grid__arrow--next"
            data-agrid-next
            aria-label="Next"
          >
            <img src="{{ 'chevron-right.svg' | asset_url }}" width="25" height="40" alt="Chevron right" />
          </button>
        </div>
      {% endif %}
    {% else %}
      <div class="article-grid__empty">Add blocks to display articles in this section.</div>
    {% endif %}
  </div>
</section>

{% style %}
  .article-grid {
    padding-top: clamp(32px, 5vw, 64px);
    padding-bottom: clamp(32px, 5vw, 64px);
  }

  .article-grid__container {
    max-width: 1200px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
  }

  .article-grid__viewport {
    overflow: hidden;
    width: 100%;
  }

  .article-grid__track {
    display: flex;
    align-items: flex-start;
    transition: transform 0.45s ease;
    will-change: transform;
  }

  .article-grid__page {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: var(--agrid-gap, 24px);
    flex: 0 0 100%;
    min-width: 100%;
    box-sizing: border-box;
  }

  .article-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .article-card__image-wrap {
    display: block;
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 4px;
    background-color: #ececec;
  }

  .article-card__image,
  .article-card__placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: fill;
    display: block;
    transition: transform 0.5s ease;
  }

  .article-card__image-wrap:hover .article-card__image {
    transform: scale(1.04);
  }

  .article-card__content {
    padding-top: 14px;
    text-align: center;
  }

  .article-card__title {
    font-size: clamp(1.3rem, 1.1vw, 17px);
    line-height: 1.35;
    margin: 0 0 6px;
    font-weight: 600;
  }

  .article-card__title-link {
    color: var(--agrid-card-title-color, #1a1a1a);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .article-card:hover > .article-card__content .article-card__title,
  .article-card:hover > .article-card__content .article-card__title-link {
    color: var(--agrid-accent-color, #e05a3c);
  }

  .article-card__text {
    color: var(--agrid-card-text-color, #8a8a8a);
    font-size: clamp(13px, 0.9vw, 14px);
    line-height: 1.5;
    margin: 0;
  }

  .article-grid__empty {
    text-align: center;
    padding: 40px 20px;
    color: #8a8a8a;
    border: 1px dashed #d4d4d4;
    border-radius: 4px;
  }

  /* Pagination */
  .article-grid__pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-top: clamp(24px, 4vw, 40px);
  }

  .article-grid__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: none;
    background: var(--agrid-arrow-bg, transparent);
    color: var(--agrid-arrow-color, #1a1a1a);
    cursor: pointer;
    padding: 0;
    transition: background-color 0.2s ease, opacity 0.2s ease;
  }

  .article-grid__arrow img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .article-grid__arrow:hover {
    background-color: rgba(0, 0, 0, 0.06);
  }

  .article-grid__arrow[disabled] {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .article-grid__dots {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .article-grid__dot {
    width: 22px;
    height: 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-family--body);
    font-size: 1rem;
    color: var(--agrid-dot-color, #b3b3b3);
    padding: 0;
    line-height: 1;
    transition: color 0.2s ease;
  }

  .article-grid__dot[aria-current='true'] {
    color: var(--agrid-dot-active-color, #e05a3c);
    font-weight: 700;
  }

  /* Mobile-first base: 1 column */
  @media screen and (max-width: 767px) {
    .article-grid__page {
      grid-template-columns: repeat(1, minmax(0, 1fr));
    }
  }

  /* Tablet */
  @media screen and (min-width: 768px) and (max-width: 1023px) {
    .article-grid__page {
      grid-template-columns: repeat(var(--agrid-columns-tablet, 2), minmax(0, 1fr));
    }
  }

  /* Desktop */
  @media screen and (min-width: 1024px) {
    .article-grid__page {
      grid-template-columns: repeat(var(--agrid-columns-desktop, 3), minmax(0, 1fr));
    }
  }
{% endstyle %}

<script>
  (function () {
    function initArticleGrid(sectionEl) {
      if (!sectionEl) return;

      var track = sectionEl.querySelector('[data-agrid-track]');
      var itemsAll = Array.prototype.slice.call(sectionEl.querySelectorAll('[data-agrid-item]'));
      var prevBtn = sectionEl.querySelector('[data-agrid-prev]');
      var nextBtn = sectionEl.querySelector('[data-agrid-next]');
      var dotsWrap = sectionEl.querySelector('[data-agrid-dots]');
      var pagination = sectionEl.querySelector('[data-agrid-pagination]');

      if (!track || itemsAll.length === 0) return;

      var currentPage = 0;

      function getColumnsPerRow() {
        var width = window.innerWidth;
        if (width >= 1024) {
          return parseInt(getComputedStyle(sectionEl).getPropertyValue('--agrid-columns-desktop')) || 3;
        } else if (width >= 768) {
          return parseInt(getComputedStyle(sectionEl).getPropertyValue('--agrid-columns-tablet')) || 2;
        }
        return 1;
      }

      function getPerPage() {
        var configured = parseInt(sectionEl.getAttribute('data-per-page'), 10);
        if (configured && configured > 0) return configured;
        var cols = getColumnsPerRow();
        return cols * 3; // default: 3 rows worth
      }

      function getTotalPages() {
        var perPage = getPerPage();
        return Math.max(1, Math.ceil(itemsAll.length / perPage));
      }

      function renderDots() {
        if (!dotsWrap) return;
        dotsWrap.innerHTML = '';
        var totalPages = getTotalPages();
        if (totalPages <= 1) {
          if (pagination) pagination.style.display = 'none';
          return;
        }
        if (pagination) pagination.style.display = 'flex';

        for (var i = 0; i < totalPages; i++) {
          var dot = document.createElement('button');
          dot.type = 'button';
          dot.className = 'article-grid__dot';
          dot.textContent = i + 1;
          dot.setAttribute('aria-current', i === currentPage ? 'true' : 'false');
          dot.setAttribute('aria-label', 'Go to page ' + (i + 1));
          (function (pageIndex) {
            dot.addEventListener('click', function () {
              goToPage(pageIndex);
            });
          })(i);
          dotsWrap.appendChild(dot);
        }
      }

      function updateArrows() {
        var totalPages = getTotalPages();
        if (prevBtn) prevBtn.disabled = currentPage === 0;
        if (nextBtn) nextBtn.disabled = currentPage >= totalPages - 1;
      }

      function goToPage(pageIndex) {
        var totalPages = getTotalPages();
        if (pageIndex < 0 || pageIndex > totalPages - 1) return;
        currentPage = pageIndex;

        // Each page is 100% of the viewport width, laid out with flexbox,
        // so shifting by currentPage * 100% moves exactly one page.
        track.style.transform = 'translateX(-' + currentPage * 100 + '%)';

        renderDots();
        updateArrows();
      }

      function layoutPages() {
        var perPage = getPerPage();
        var totalPages = getTotalPages();

        // Rebuild real per-page grid containers so each page keeps its own
        // grid-template-columns (driven by CSS / --agrid-columns-*), instead
        // of forcing every item into a single grid-column track.
        var pages = [];
        for (var p = 0; p < totalPages; p++) {
          var pageEl = document.createElement('div');
          pageEl.className = 'article-grid__page';
          pageEl.setAttribute('data-agrid-page', '');
          pages.push(pageEl);
        }

        itemsAll.forEach(function (item, index) {
          var pageIndex = Math.floor(index / perPage);
          pages[pageIndex].appendChild(item);
        });

        // Clear the track and re-append the freshly built pages.
        track.innerHTML = '';
        pages.forEach(function (pageEl) {
          track.appendChild(pageEl);
        });

        currentPage = Math.min(currentPage, totalPages - 1);
        goToPage(currentPage);
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function () {
          goToPage(currentPage - 1);
        });
      }
      if (nextBtn) {
        nextBtn.addEventListener('click', function () {
          goToPage(currentPage + 1);
        });
      }

      var resizeTimeout;
      window.addEventListener('resize', function () {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(layoutPages, 150);
      });

      layoutPages();
    }

    function initAll() {
      document.querySelectorAll('.article-grid').forEach(initArticleGrid);
    }

    document.addEventListener('DOMContentLoaded', initAll);

    document.addEventListener('shopify:section:load', function (event) {
      var sectionEl = event.target.querySelector('.article-grid');
      if (sectionEl) initArticleGrid(sectionEl);
    });
  })();
</script>

{% schema %}
{
  "name": "Article Grid",
  "tag": "section",
  "class": "shopify-section--article-grid",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Columns on tablet",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap (px)",
      "min": 8,
      "max": 48,
      "step": 2,
      "default": 24
    },
    {
      "type": "range",
      "id": "items_per_page",
      "label": "Items per page (0 = auto)",
      "info": "Set to 0 to auto-calculate based on columns (3 rows per page).",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 9
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show pagination controls",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "section_padding_top",
      "label": "Enable extra top padding",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Card title color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card text color",
      "default": "#8a8a8a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / hover color",
      "default": "#e05a3c"
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Arrow icon color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "arrow_bg_color",
      "label": "Arrow background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Pagination number color",
      "default": "#b3b3b3"
    },
    {
      "type": "color",
      "id": "dot_active_color",
      "label": "Active page number color",
      "default": "#e05a3c"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Article Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Fashion Is Like Nature's Beauty"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Article Grid",
      "category": "Custom sections",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
