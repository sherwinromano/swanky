<footer
  class="footer-custom w-full"
>
  <div class="mx-auto flex flex-col gap-20">
    <div class="footer-custom__grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-5 lg:gap-x-37.5 gap-y-10">
      <div class="footer-custom__brand flex flex-col">
        {% if section.settings.logo != blank %}
          <a href="{{ routes.root_url }}" class="inline-block w-fit">
            {{
              section.settings.logo
              | image_url: width: 300
              | image_tag: loading: 'lazy', class: 'h-8! w-auto object-contain', alt: shop.name
            }}
          </a>
        {% elsif section.settings.brand_name != blank %}
          <a href="{{ routes.root_url }}" class="inline-block w-fit no-underline">
            <span class="text-2xl md:text-3xl font-bold tracking-tight uppercase" style="color: var(--footer-heading);">
              {{ section.settings.brand_name -}}
              <span style="color: var(--footer-link-hover);">.</span>
            </span>
          </a>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="footer-custom__description text-sm leading-relaxed opacity-55 pt-3.75">
            {{ section.settings.description }}
          </div>
        {% endif %}

        {% if section.settings.show_newsletter %}
          <form
            action="/contact#footer-newsletter"
            method="post"
            accept-charset="UTF-8"
            class="footer-custom__newsletter-form max-w-full flex"
            data-newsletter-form
          >
            <input type="hidden" name="form_type" value="customer">
            <input type="hidden" name="utf8" value="✓">
            <input type="hidden" name="contact[tags]" value="newsletter">

            <div class="flex items-center gap-4 border-b border-b-[#040404] w-full">
              <label for="FooterNewsletter-{{ section.id }}" class="sr-only">
                {{ section.settings.newsletter_placeholder | default: 'Email address' }}
              </label>
              <input
                id="FooterNewsletter-{{ section.id }}"
                type="email"
                name="contact[email]"
                placeholder="{{ section.settings.newsletter_placeholder }}"
                required
                class="footer-custom__newsletter-input flex-1 bg-transparent py-2 text-sm placeholder:opacity-60 outline-none w-1/2"
              >
              <button
                type="submit"
                aria-label="Subscribe"
                class="footer-custom__newsletter-submit shrink-0 pb-1 grid items-center"
              >
                <img
                  src="{{ 'email-send.svg' | asset_url }}"
                  alt="Subscribe"
                  height="24"
                  width="24"
                  class="h-6 w-6 object-contain"
                >
              </button>
            </div>
          </form>
        {% endif %}

        {% if section.settings.show_social %}
          <div class="footer-custom__social flex items-center gap-4 pt-8.75">
            {% if section.settings.social_facebook != blank %}
              <a
                href="{{ section.settings.social_facebook }}"
                class="footer-custom__social-link text-[#C0BAB9]"
                aria-label="Facebook"
                target="_blank"
                rel="noopener"
              >
                <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.15 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.23.2 2.23.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.91h-2.34V22c4.78-.79 8.44-4.94 8.44-9.94Z"/>
                </svg>
              </a>
            {% endif %}
            {% if section.settings.social_instagram != blank %}
              <a
                href="{{ section.settings.social_instagram }}"
                class="footer-custom__social-link text-[#C0BAB9]"
                aria-label="Instagram"
                target="_blank"
                rel="noopener"
              >
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/>
                </svg>
              </a>
            {% endif %}
            {% if section.settings.social_twitter != blank %}
              <a
                href="{{ section.settings.social_twitter }}"
                class="footer-custom__social-link text-[#C0BAB9]"
                aria-label="Twitter"
                target="_blank"
                rel="noopener"
              >
                <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817-5.966 6.817H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              </a>
            {% endif %}
            {% if section.settings.social_linkedin != blank %}
              <a
                href="{{ section.settings.social_linkedin }}"
                class="footer-custom__social-link text-[#C0BAB9]"
                aria-label="LinkedIn"
                target="_blank"
                rel="noopener"
              >
                <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.83v1.64h.05c.53-1 1.84-2.06 3.79-2.06 4.05 0 4.8 2.67 4.8 6.14V21h-4v-5.34c0-1.27-.02-2.9-1.77-2.9-1.77 0-2.04 1.38-2.04 2.81V21h-4V9Z"/>
                </svg>
              </a>
            {% endif %}
            {% if section.settings.social_youtube != blank %}
              <a
                href="{{ section.settings.social_youtube }}"
                class="footer-custom__social-link text-[#C0BAB9]"
                aria-label="YouTube"
                target="_blank"
                rel="noopener"
              >
                <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M23.5 6.5a3 3 0 0 0-2.1-2.1C19.5 4 12 4 12 4s-7.5 0-9.4.4A3 3 0 0 0 .5 6.5 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.5 3 3 0 0 0 2.1 2.1C4.5 20 12 20 12 20s7.5 0 9.4-.4a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.5ZM9.6 15.5v-7l6.3 3.5-6.3 3.5Z"/>
                </svg>
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>

      {% comment %} ----- Repeatable Blocks (menu columns + contact) ----- {% endcomment %}
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'quick_links' %}
            <nav
              class="footer-custom__menu-column flex flex-col"
              aria-label="{{ block.settings.heading | default: 'Footer menu' }}"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.heading != blank %}
                <h3 class="text-[1.375rem] pb-3.75">
                  {{ block.settings.heading }}
                </h3>
              {% endif %}
              {% if block.settings.quick_links_menu != blank %}
                <ul class="flex flex-col gap-2 list-none p-0 m-0">
                  {% for link in block.settings.quick_links_menu.links %}
                    <li>
                      <a
                        href="{{ link.url }}"
                        class="footer-custom__link text-sm tracking-wide uppercase hover:underline"
                      >
                        {{ link.title }}
                      </a>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </nav>
          {% when 'help_info' %}
            <nav
              class="footer-custom__menu-column flex flex-col"
              aria-label="{{ block.settings.heading | default: 'Footer menu' }}"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.heading != blank %}
                <h3 class="text-[1.375rem] pb-3.75">
                  {{ block.settings.heading }}
                </h3>
              {% endif %}
              {% if block.settings.help_info_menu != blank %}
                <ul class="flex flex-col gap-2 list-none p-0 m-0">
                  {% for link in block.settings.help_info_menu.links %}
                    <li>
                      <a
                        href="{{ link.url }}"
                        class="footer-custom__link text-sm tracking-wide uppercase hover:underline"
                      >
                        {{ link.title }}
                      </a>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </nav>
          {% when 'contact_us' %}
            <address
              class="footer-custom__contact flex flex-col not-italic"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.heading != blank %}
                <h3 class="text-[1.375rem] pb-3.75">
                  {{ block.settings.heading }}
                </h3>
              {% endif %}

              {% if block.settings.text != blank %}
                <p class="text-sm opacity-80 m-0">{{ block.settings.text }}</p>
              {% endif %}
              {% if block.settings.email != blank %}
                <a
                  href="mailto:{{ block.settings.email }}"
                  class="footer-custom__link text-sm font-semibold underline w-fit pb-3.5"
                  style="font-family: var(--font-secondary--family);"
                >
                  {{ block.settings.email }}
                </a>
              {% endif %}

              {% if block.settings.support_text != blank %}
                <p class="text-sm opacity-80 m-0">{{ block.settings.support_text }}</p>
              {% endif %}
              {% if block.settings.phone != blank %}
                <a
                  href="tel:{{ block.settings.phone | replace: ' ', '' }}"
                  class="footer-custom__link text-sm font-semibold underline w-fit pb-3.5"
                  style="font-family: var(--font-secondary--family);"
                >
                  {{ block.settings.phone }}
                </a>
              {% endif %}
            </address>
        {% endcase %}
      {% endfor %}
    </div>

    {% if section.settings.show_payment_icons != blank %}
      <div
        class="footer-custom__bottom mt-12 py-6 flex justify-center gap-4 border-t border-t-[#DDD3D1] text-xs"
      >
        <div class="footer-custom__bottom-left flex flex-wrap items-center justify-center gap-4">
          {% if section.settings.show_payment_icons %}
            <div class="footer-custom__payment flex items-center flex-col gap-3">
              <span class="opacity-70">Payment options</span>
              <div class="flex gap-2">
                {% for type in shop.enabled_payment_types %}
                  {{ type | payment_type_svg_tag: class: 'h-2 w-auto' }}
                {% endfor %}
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
</footer>

<script>
  document.addEventListener('shopify:section:load', function (event) {
    if (event.target.querySelector('.footer-custom')) {
      initFooterCustomNewsletter(event.target);
    }
  });
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.footer-custom').forEach(initFooterCustomNewsletter);
  });

  function initFooterCustomNewsletter(root) {
    var form = root.querySelector('[data-newsletter-form]');
    if (!form || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    form.addEventListener('submit', function (e) {
      var input = form.querySelector('input[type="email"]');
      if (input && input.value.trim() === '') {
        e.preventDefault();
        input.focus();
      }
    });
  }
</script>

{% stylesheet %}
  .footer-custom a {
    transition: color 0.15s ease;
    font-family: var(--font-primary--family);
  }
  .footer-custom__link:hover,
  .footer-custom__social-link:hover {
    color: var(--color-accent) !important;
  }
  .footer-custom__newsletter-input::placeholder {
    color: #a9a09e;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name (used if no logo)",
      "default": "Swanky"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Input placeholder",
      "default": "Enter your email address"
    },
    {
      "type": "header",
      "content": "Social media"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social icons",
      "default": true
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_twitter",
      "label": "Twitter/X URL"
    },
    {
      "type": "url",
      "id": "social_linkedin",
      "label": "LinkedIn URL"
    },
    {
      "type": "url",
      "id": "social_youtube",
      "label": "YouTube URL"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "quick_links",
      "name": "Quick links",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quick Links"
        },
        {
          "type": "link_list",
          "id": "quick_links_menu",
          "label": "Quick links menu"
        }
      ]
    },
    {
      "type": "help_info",
      "name": "Help & Info",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Help & Info"
        },
        {
          "type": "link_list",
          "id": "help_info_menu",
          "label": "Help & Info menu"
        }
      ]
    },
    {
      "type": "contact_us",
      "name": "Contact Us",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Contact Us"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Query text",
          "default": "Do you have any queries or suggestions?"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email address",
          "default": "example@gmail.com"
        },
        {
          "type": "text",
          "id": "support_text",
          "label": "Support text",
          "default": "If you need support? Just give us a call."
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone number",
          "default": "+11 222 333 444 55"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "default": {
    "settings": {},
    "blocks": [
      {
        "type": "quick_links",
        "settings": {
          "heading": "Quick Links"
        }
      },
      {
        "type": "help_info",
        "settings": {
          "heading": "Help & Info"
        }
      },
      {
        "type": "contact_us",
        "settings": {
          "heading": "Contact Us"
        }
      }
    ]
  }
}
{% endschema %}
