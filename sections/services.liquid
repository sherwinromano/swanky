<section
  class="services-{{ section.id }} w-full"
  data-section-id="{{ section.id }}"
  data-section-type="services"
>
  <div class="services-{{ section.id }}__container grid grid-cols-1 md:grid-cols-3  gap-x-10 gap-y-10">
    {% for block in section.blocks %}
      <div
        class="flex flex-col items-center justify-center text-center p-6 border-y"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.icon != 'none' %}
          <span class="services-{{ section.id }}__icon inline-flex items-center justify-center w-10 h-10 mb-3.5!">
            {% case block.settings.icon %}
              {% when 'truck' %}
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M2 6.5C2 5.67157 2.67157 5 3.5 5H13.5C14.3284 5 15 5.67157 15 6.5V15.5H2V6.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                  <path d="M15 9.5H18.4384C18.7873 9.5 19.1067 9.69552 19.2658 10.0058L20.8274 13.0521C20.9407 13.2732 21 13.5182 21 13.767V15.5H15V9.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                  <circle cx="6.5" cy="17.5" r="1.75" stroke="currentColor" stroke-width="1.4"/>
                  <circle cx="17.5" cy="17.5" r="1.75" stroke="currentColor" stroke-width="1.4"/>
                </svg>
              {% when 'bag' %}
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M5.5 8.5C5.5 7.94772 5.94772 7.5 6.5 7.5H17.5C18.0523 7.5 18.5 7.94772 18.5 8.5V19C18.5 19.5523 18.0523 20 17.5 20H6.5C5.94772 20 5.5 19.5523 5.5 19V8.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                  <path d="M8.5 7.5V6.5C8.5 4.84315 9.84315 3.5 11.5 3.5H12.5C14.1569 3.5 15.5 4.84315 15.5 6.5V7.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                </svg>
              {% when 'gift' %}
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="3.5" y="8.5" width="17" height="4" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                  <rect x="4.5" y="12.5" width="15" height="8" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                  <path d="M12 8.5V20.5" stroke="currentColor" stroke-width="1.4"/>
                  <path d="M12 8.5C12 8.5 8.5 8.5 8.5 6C8.5 4.5 9.5 3.5 10.5 3.5C11.8 3.5 12 6.5 12 8.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                  <path d="M12 8.5C12 8.5 15.5 8.5 15.5 6C15.5 4.5 14.5 3.5 13.5 3.5C12.2 3.5 12 6.5 12 8.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                </svg>
              {% when 'shield' %}
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 3.5L19 6V11.5C19 15.75 16 19 12 20.5C8 19 5 15.75 5 11.5V6L12 3.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                  <path d="M9 12L11 14L15.5 9.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {% when 'return' %}
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M4 12C4 7.58172 7.58172 4 12 4C15.3729 4 18.2523 6.09409 19.4067 9.05426" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                  <path d="M20 5V9.5H15.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M20 12C20 16.4183 16.4183 20 12 20C8.62711 20 5.74769 17.9059 4.59331 14.9457" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                  <path d="M4 19V14.5H8.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {% when 'support' %}
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M4 13V11C4 6.58172 7.58172 3 12 3C16.4183 3 20 6.58172 20 11V13" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                  <rect x="3" y="13" width="4" height="5" rx="1" stroke="currentColor" stroke-width="1.4"/>
                  <rect x="17" y="13" width="4" height="5" rx="1" stroke="currentColor" stroke-width="1.4"/>
                  <path d="M19 18V19C19 20.1046 18.1046 21 17 21H13" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                </svg>
              {% when 'heart' %}
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 20.5C12 20.5 3.5 15.5 3.5 9.5C3.5 6.73858 5.73858 4.5 8.5 4.5C10.0113 4.5 11.3623 5.17662 12 6.25C12.6377 5.17662 13.9887 4.5 15.5 4.5C18.2614 4.5 20.5 6.73858 20.5 9.5C20.5 15.5 12 20.5 12 20.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                </svg>
              {% when 'star' %}
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 3.5L14.7213 9.01606L20.8042 9.90492L16.4021 14.1959L17.4426 20.2549L12 17.3936L6.55738 20.2549L7.59788 14.1959L3.19577 9.90492L9.27869 9.01606L12 3.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                </svg>
            {% endcase %}
          </span>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h3 class="services-{{ section.id }}__heading m-0 text-[1.375rem] leading-tight mb-2!">
            {{ block.settings.heading }}
          </h3>
        {% endif %}

        {% if block.settings.text != blank %}
          <p class="services-{{ section.id }}__text m-0 text-sm md:text-base leading-normal">
            {{ block.settings.text }}
          </p>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>

{% style %}
  .services-{{ section.id }}__container,
  .services-{{ section.id }}__container > div {
    border-color: {{ section.settings.divider_color }};
  }

  .services-{{ section.id }}__icon {
    color: var(--color-accent);
  }

  .services-{{ section.id }}__heading {
    color: var(--color-primary);
  }

  .services-{{ section.id }}__text {
    color: {{ section.settings.text_color }};
  }
{% endstyle %}

{% schema %}
{
  "name": "Services",
  "tag": "section",
  "class": "section-services max-width",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Border color",
      "default": "#DDD3D1"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#737373"
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Truck" },
            { "value": "bag", "label": "Bag" },
            { "value": "gift", "label": "Gift" },
            { "value": "shield", "label": "Shield" },
            { "value": "return", "label": "Return arrows" },
            { "value": "support", "label": "Support headset" },
            { "value": "heart", "label": "Heart" },
            { "value": "star", "label": "Star" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quick Delivery"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Inside city delivery within 5 days"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Services",
      "blocks": [
        {
          "type": "service",
          "settings": {
            "icon": "truck",
            "heading": "Quick Delivery",
            "text": "Inside City delivery within 5 days"
          }
        },
        {
          "type": "service",
          "settings": {
            "icon": "bag",
            "heading": "Pick Up In Store",
            "text": "We have option of pick up in store."
          }
        },
        {
          "type": "service",
          "settings": {
            "icon": "gift",
            "heading": "Special Packaging",
            "text": "Our packaging is best for products."
          }
        }
      ]
    }
  ]
}
{% endschema %}
