{%- style -%}
  #shopify-section-{{ section.id }} .services-strip {
    --services-strip-icon: {{ section.settings.icon_color }};
    --services-strip-heading: {{ section.settings.heading_color }};
    --services-strip-text: {{ section.settings.text_color }};
    --services-strip-border: {{ section.settings.border_color }};
    --services-strip-pt: {{ section.settings.padding_top }}px;
    --services-strip-pb: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div class="services-strip color-scheme-none scroll-trigger animate--slide-in">
  <div class="services-strip__inner{% if section.settings.use_page_width %} page-width{% endif %}">
    {%- if section.blocks.size > 0 -%}
      <ul class="services-strip__list" role="list">
        {%- for block in section.blocks -%}
          <li class="services-strip__item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon_image != blank -%}
              <span class="services-strip__icon" aria-hidden="true">
                {{
                  block.settings.icon_image
                  | image_url: width: 96
                  | image_tag: loading: 'lazy', width: 32, height: 32, alt: '', class: 'services-strip__icon-img'
                }}
              </span>
            {%- elsif block.settings.icon != 'none' -%}
              <span class="services-strip__icon" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'truck' -%}
                    <svg
                      viewBox="0 0 24 24"
                      width="32"
                      height="32"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      focusable="false"
                    >
                      <path d="M2.5 6.5h10v9h-10z"/><path d="M12.5 9.5h4l3 3v3h-7"/><circle cx="6.5" cy="17" r="1.8"/><circle cx="16.5" cy="17" r="1.8"/>
                    </svg>
                  {%- when 'bag' -%}
                    <svg
                      viewBox="0 0 24 24"
                      width="32"
                      height="32"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      focusable="false"
                    >
                      <path d="M5.5 8h13l.8 12.5H4.7z"/><path d="M9 11V6.5a3 3 0 0 1 6 0V11"/>
                    </svg>
                  {%- when 'gift' -%}
                    <svg
                      viewBox="0 0 24 24"
                      width="32"
                      height="32"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      focusable="false"
                    >
                      <rect x="3" y="9" width="18" height="11" rx="1.5"/><path d="M3 13.5h18M12 9v11"/><path d="M12 9c-2.5 0-4-3.5-1.5-4 1.8-.3 1.5 4 1.5 4zm0 0c2.5 0 4-3.5 1.5-4-1.8-.3-1.5 4-1.5 4z"/>
                    </svg>
                {%- endcase -%}
              </span>
            {%- endif -%}

            {%- if block.settings.heading != blank -%}
              <h3 class="services-strip__heading">{{ block.settings.heading | escape }}</h3>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <p class="services-strip__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .services-strip {
    padding-block: var(--services-strip-pt) var(--services-strip-pb);
  }

  .services-strip__inner:not(.page-width) {
    padding-inline: 1.5rem;
  }

  .services-strip__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .services-strip__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: 24px;
    text-align: center;
    border-block: 0.1rem solid var(--services-strip-border);
  }

  .services-strip__icon {
    display: inline-flex;
    width: 3.8rem;
    height: 3.8rem;
    margin-bottom: 1.6rem;
    color: var(--services-strip-icon);
  }

  .services-strip__icon svg,
  .services-strip__icon-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .services-strip__heading {
    margin: 0 0 8px;
    font-family: var(--font-heading-family);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--services-strip-heading);
  }

  .services-strip__text {
    margin: 0;
    font-family: var(--font-body-family);
    font-size: 1.6rem;
    line-height: 100%;
    color: var(--services-strip-text);
  }

  @media screen and (min-width: 1024px) {
    .services-strip__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: clamp(4rem, 10vw, 14rem);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Services",
  "tag": "section",
  "class": "section",
  "limit": 1,
  "max_blocks": 6,
  "settings": [
    { "type": "checkbox", "id": "use_page_width", "label": "Constrain to page width", "default": false },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "icon_color", "label": "Icon", "default": "#EE6B55" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#040404" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#737373" },
    { "type": "color", "id": "border_color", "label": "Divider lines", "default": "#DDD3D1" },
    { "type": "header", "content": "Spacing" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Built-in icon",
          "options": [
            { "value": "truck", "label": "Delivery truck" },
            { "value": "bag", "label": "Shopping bag" },
            { "value": "gift", "label": "Gift box" },
            { "value": "none", "label": "None" }
          ],
          "default": "truck"
        },
        { "type": "image_picker", "id": "icon_image", "label": "Custom icon (overrides built-in)" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Quick Delivery" },
        { "type": "text", "id": "text", "label": "Text", "default": "Inside City delivery within 5 days" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Services",
      "blocks": [
        {
          "type": "service",
          "settings": { "icon": "truck", "heading": "Quick Delivery", "text": "Inside City delivery within 5 days" }
        },
        {
          "type": "service",
          "settings": { "icon": "bag", "heading": "Pick Up In Store", "text": "We have option of pick up in store." }
        },
        {
          "type": "service",
          "settings": { "icon": "gift", "heading": "Special Packaging", "text": "Our packaging is best for products." }
        }
      ]
    }
  ]
}
{% endschema %}
