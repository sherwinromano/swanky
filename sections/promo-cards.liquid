{{ 'promo-cards.css' | asset_url | stylesheet_tag }}

<section
  class="promo-cards promo-cards--{{ section.id }}"
  style="
    --promo-cards-gap: {{ section.settings.gap }}px;
    --promo-cards-text: {{ section.settings.text_color }};
    --promo-cards-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --promo-cards-padding-top: {{ section.settings.padding_top }}px;
    --promo-cards-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  {%- if section.blocks.size > 0 -%}
    <ul class="promo-cards__list" role="list">
      {%- for block in section.blocks -%}
        <li class="promo-cards__item" {{ block.shopify_attributes }}>
          <article class="promo-cards__card">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1500
                | image_tag:
                  class: 'promo-cards__image',
                  widths: '375, 550, 750, 1100, 1500',
                  sizes: '(min-width: 1024px) 50vw, 100vw',
                  loading: 'lazy',
                  alt: block.settings.image.alt
              }}
            {%- else -%}
              <div class="promo-cards__image promo-cards__image--placeholder">
                {{ 'lifestyle-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}

            <div class="promo-cards__content">
              {%- if block.settings.heading != blank -%}
                <h2 class="promo-cards__heading">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <p class="promo-cards__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}

              {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
                <a
                  href="{{ block.settings.button_link }}"
                  class="promo-cards__button promo-cards__button--{{ block.settings.button_style }}"
                >
                  {{- block.settings.button_label | escape -}}
                </a>
              {%- endif -%}
            </div>
          </article>
        </li>
      {%- endfor -%}
    </ul>
  {%- elsif request.design_mode -%}
    <p class="promo-cards__empty">Add a card block to get started.</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Promo cards",
  "tag": "div",
  "class": "section",
  "limit": 1,
  "max_blocks": 4,
  "settings": [
    { "type": "color", "id": "text_color", "label": "Text and button color", "default": "#FFFFFF" },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 10,
      "info": "Darkens images to keep text readable."
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between cards",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    { "type": "header", "content": "Spacing" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Summer Outfits" },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Erat consequ at aliquet semper rhoncus fell diam non faucibus. Tristique in vitae aliquam consequat massa nunc quisque."
        },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop collection" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            { "value": "solid", "label": "Solid" },
            { "value": "outline", "label": "Outline" }
          ],
          "default": "solid"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo cards",
      "blocks": [
        { "type": "card" },
        {
          "type": "card",
          "settings": {
            "heading": "Accessories",
            "text": "Commodo quam dis nisl ultrices a ac. Augue purus pretium in eu ut etiam et nunc lacus.",
            "button_label": "Shop it now",
            "button_style": "outline"
          }
        }
      ]
    }
  ]
}
{% endschema %}
