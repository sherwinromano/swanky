{% liquid
  assign hero_image = section.settings.hero_image | default: section.settings.mobile_hero_image
  assign hero_alt = hero_image.alt | default: section.settings.heading
%}

<section
  class="hero-banner-{{ section.id }} relative flex w-full overflow-hidden h-dvh lg:h-screen"
  data-section-id="{{ section.id }}"
  data-section-type="hero-banner"
>
  <div class="absolute inset-0 w-full h-full flex">
    {% if hero_image != blank %}
      <picture class="block w-full h-full">
        {% if section.settings.mobile_hero_image != blank %}
          <source
            media="(max-width: 767px)"
            srcset="{{ section.settings.mobile_hero_image | image_url: width: 750 }} 750w, {{ section.settings.mobile_hero_image | image_url: width: 1080 }} 1080w"
            sizes="100vw"
          >
        {% endif %}
        {% if section.settings.hero_image != blank %}
          <source
            media="(min-width: 768px)"
            srcset="{{ section.settings.hero_image | image_url: width: 1280 }} 1280w, {{ section.settings.hero_image | image_url: width: 1920 }} 1920w, {{ section.settings.hero_image | image_url: width: 2560 }} 2560w"
            sizes="100vw"
          >
        {% endif %}
        {{
          hero_image
          | image_url: width: 1920
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            class: 'w-full h-full! object-cover object-center block',
            alt: hero_alt,
            widths: '750, 1080, 1280, 1920, 2560'
        }}
      </picture>
    {% else %}
      <div class="w-full h-full bg-neutral-200">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'w-full h-full object-cover' }}
      </div>
    {% endif %}

    <div class="hero-banner__overlay absolute inset-0 pointer-events-none"></div>
  </div>

  <div
    class="relative z-10 flex w-full px-6 text-center{% if section.settings.content_position == 'top' %} items-start justify-center pt-20{% elsif section.settings.content_position == 'bottom' %} items-end justify-center pb-20{% else %} items-center justify-center{% endif %}"
  >
    <div class="hero-banner__content flex flex-col items-center gap-4 w-full">
      {% if section.settings.heading != blank %}
        <h1 class="m-0 text-white! font-bold leading-tight text-[2.375rem] md:text-[3rem] lg:text-[3.625rem]">
          {{ section.settings.heading }}
        </h1>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            role="link" aria-disabled="true"
          {% endif %}
          class="hero-banner__button--{{ section.settings.button_style }} inline-flex items-center justify-center w-fit px-12 py-[0.88rem] text-sm tracking-widest transition cursor-pointer uppercase font-semibold no-underline border duration-200{% if section.settings.button_style == 'outline' %} bg-transparent border-white{% else %} bg-white text-[#040404] border-white hover:bg-transparent hover:text-white{% endif %}"
        >
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% style %}
  section#shopify-section-{{ section.id }} {
    display: block;
  }

  .hero-banner-{{ section.id }} .hero-banner__overlay {
    background-color: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }

  .hero-banner-{{ section.id }} .hero-banner__content {
    max-width: {{ section.settings.content_max_width }}px;
  }

  .hero-banner-{{ section.id }} .hero-banner__button--outline {
    color: #fff;
  }

  .hero-banner-{{ section.id }} .hero-banner__button--outline:hover {
    background-color: var(--color-primary);
    color: #fff;
  }
{% endstyle %}

{% schema %}
{
  "name": "Hero section",
  "tag": "section",
  "class": "section-hero-banner",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Hero image"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "image_picker",
      "id": "mobile_hero_image",
      "label": "Mobile hero image",
      "info": "Optional image shown on screens narrower than 768px."
    },
    {
      "type": "header",
      "content": "Hero content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Make Your Fashion Look Swanky."
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 400,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 700
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "solid"
    },
    {
      "type": "header",
      "content": "Colors & Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#040404"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "Hero section",
      "settings": {
        "heading": "Make Your Fashion Look Swanky.",
        "button_label": "Shop Now"
      }
    }
  ]
}
{% endschema %}
