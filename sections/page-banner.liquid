{{ 'page-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign crumb_parent_title = blank
  assign crumb_parent_url = blank

  case template.name
    when 'index'
      assign current_title = shop.name
    when 'page'
      assign current_title = page.title
    when 'product'
      assign current_title = product.title
      if collection != blank
        assign crumb_parent_title = collection.title
        assign crumb_parent_url = collection.url
      endif
    when 'collection'
      assign current_title = collection.title
    when 'blog'
      assign current_title = blog.title
    when 'article'
      assign current_title = article.title
      assign crumb_parent_title = blog.title
      assign crumb_parent_url = blog.url
    else
      assign current_title = page_title
  endcase

  if section.settings.custom_title != blank
    assign current_title = section.settings.custom_title
  endif

  assign heading_tag = section.settings.heading_tag
-%}

<section
  class="scroll-trigger animate--slide-in page-banner page-banner--{{ section.id }}{% if section.settings.image != blank %} page-banner--has-image{% endif %}"
  style="
    --page-banner-bg: {{ section.settings.background_color }};
    --page-banner-text: {{ section.settings.text_color }};
    --page-banner-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --page-banner-min-height: {{ section.settings.min_height }}px;
  "
>
  {%- if section.settings.image != blank -%}
    {{
      section.settings.image
      | image_url: width: 2000
      | image_tag:
        class: 'page-banner__image',
        widths: '375, 750, 1100, 1500, 2000',
        sizes: '100vw',
        loading: 'eager',
        alt: ''
    }}
  {%- endif -%}

  <div class="page-banner__content">
    <{{ heading_tag }} class="page-banner__title">{{ current_title | escape }}</{{ heading_tag }}>

    {%- if section.settings.show_breadcrumb and template.name != 'index' -%}
      <nav class="page-banner__breadcrumb" aria-label="Breadcrumb">
        <ol class="page-banner__breadcrumb-list" role="list">
          <li class="page-banner__breadcrumb-item">
            <a class="page-banner__breadcrumb-link" href="{{ routes.root_url }}">
              {{- section.settings.home_label | escape -}}
            </a>
          </li>
          <li class="page-banner__breadcrumb-separator" aria-hidden="true">
            {{- 'caret-right.svg' | inline_asset_content -}}
          </li>
          {%- if crumb_parent_title != blank -%}
            <li class="page-banner__breadcrumb-item">
              <a class="page-banner__breadcrumb-link" href="{{ crumb_parent_url }}">
                {{- crumb_parent_title | escape -}}
              </a>
            </li>
          {%- endif -%}
          <li
            class="page-banner__breadcrumb-item"
            aria-current="page"
            style="text-decoration: underline; text-underline-offset: 0.3rem;"
          >
            {{ current_title | escape }}
          </li>
        </ol>
      </nav>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Page banner",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    {
      "type": "text",
      "id": "custom_title",
      "label": "Custom title",
      "info": "Leave empty to automatically show the current page, product, collection or article title."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Title heading level",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" }
      ],
      "default": "h1",
      "info": "Use H2 if the page template already outputs its own H1."
    },
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Show breadcrumb", "default": true },
    { "type": "text", "id": "home_label", "label": "Home link label", "default": "Home" },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#FFFFFF" },
    { "type": "color", "id": "background_color", "label": "Fallback background", "default": "#6F6A68" },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height (desktop)",
      "min": 120,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 260
    }
  ],
  "presets": [{ "name": "Page banner" }]
}
{% endschema %}
