{%- style -%}
  .testimonials-section--{{ section.id }} .testimonials__container {
    max-width: {{ section.settings.container_max_width }}px;
    margin: 0 auto;
    padding-left: {{ section.settings.padding_horizontal }}px;
    padding-right: {{ section.settings.padding_horizontal }}px;
    position: relative;
  }

  /* Testimonial Track & Slide Transitions */
  .testimonials__slider {
    position: relative;
    width: 100%;
    overflow: hidden;

  }

  .testimonials__slide {
    display: none;
    opacity: 0;
    transition: opacity 0.4s ease-in-out;
    text-align: center;

    flex-direction: column;
  }

  .testimonials__slide.is-active {
    display: flex;
    opacity: 1;
  }

  /* Decorative Quote Icon */
  .testimonials__quote-icon {
    display: block;
    align-self: center;
  }

  .testimonials__quote-svg {
    width: 90px;
    height: auto;
  }

  /* Typography & Content Styling */
  .testimonials__text {
    font-size: 1.125rem; /* ~18px */
    line-height: 1.6;
    font-style: italic;
    color: #8A8A8A;
    max-width: 800px;
    margin: 0 auto 24px auto;
    letter-spacing: -0.01em;
  }

  /* Stars Rating Styling */
  .testimonials__stars {
    display: flex;
    justify-content: center;
    gap: 4px;
  }

  .testimonials__star {
    font-size: 1.125rem;
    color: #161616;
  }

  /* Author Styling */
  .testimonials__author {
    font-size: 0.875rem; /* ~14px */
    font-weight: 700;
    text-transform: capitalize;
    color: #EC6C5A;
    margin: 0;
  }

  /* Navigation: Responsive positioning matching mockups */
  .testimonials__navigation {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 40px;
  }

  .testimonials__arrow {
    background: none;
    border: none;
    padding: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #121212;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .testimonials__arrow:hover {
    transform: scale(1.1);
  }

  .testimonials__arrow-icon {
    width: 24px;
    height: auto;
  }

  /* Responsive Adjustments */
  @media screen and (min-width: 1024px) {

    .testimonials__text {
      font-size: 1.375rem; /* ~22px */
    }

    /* Desktop Navigation: Positioned at far left & right edges of the container */
    .testimonials__navigation {
      position: absolute;
      top: 50%;
      left: 0;
      right: 0;
      transform: translateY(-50%);
      display: flex;
      justify-content: space-between;
      pointer-events: none;
      margin-top: 0;
      padding-left: {{ section.settings.padding_horizontal }}px;
      padding-right: {{ section.settings.padding_horizontal }}px;
    }

    .testimonials__arrow {
      pointer-events: auto;
    }
  }
{%- endstyle -%}

<section class="testimonials-section testimonials-section--{{ section.id }}" aria-label="Customer Testimonials">
  <div class="testimonials__container">
    <div class="testimonials__slider">
      {%- for block in section.blocks -%}
        <div
          class="testimonials__slide {% if forloop.first %}is-active{% endif %}"
          data-index="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          <div class="testimonials__quote-icon">
            <img
              src="{{ 'quotation.png' | asset_url }}"
              alt="Quote icon"
              width="91"
              height="65"
              class="testimonials__quote-svg"
              loading="lazy"
            >
          </div>

          {%- if block.settings.quote != blank -%}
            <blockquote class="testimonials__text">"{{ block.settings.quote }}"</blockquote>
          {%- endif -%}

          {%- if block.settings.star_rating > 0 -%}
            <div class="testimonials__stars" aria-label="Rated {{ block.settings.star_rating }} out of 5 stars">
              {%- for i in (1..block.settings.star_rating) -%}
                <span class="testimonials__star" aria-hidden="true">★</span>
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if block.settings.author != blank -%}
            <p class="testimonials__author">{{ block.settings.author | escape }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <div class="testimonials__navigation">
        <button class="testimonials__arrow testimonials__arrow--prev" aria-label="Previous Testimonial">
          <img
            src="{{ 'la_arrow-left.svg' | asset_url }}"
            width="38"
            height="38"
            loading="lazy"
            alt="Previous Testimonial"
          >
        </button>
        <button class="testimonials__arrow testimonials__arrow--next" aria-label="Next Testimonial">
          <img
            src="{{ 'la_arrow-right.svg' | asset_url }}"
            width="38"
            height="38"
            loading="lazy"
            alt="Next Testimonial"
          >
        </button>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const sectionContainer = document.querySelector('.testimonials-section--{{ section.id }}');
    if (!sectionContainer) return;

    const slides = sectionContainer.querySelectorAll('.testimonials__slide');
    const prevBtn = sectionContainer.querySelector('.testimonials__arrow--prev');
    const nextBtn = sectionContainer.querySelector('.testimonials__arrow--next');

    if (slides.length <= 1) return;

    let currentIndex = 0;

    function showSlide(index) {
      slides[currentIndex].classList.remove('is-active');
      currentIndex = (index + slides.length) % slides.length;
      slides[currentIndex].classList.add('is-active');
    }

    prevBtn.addEventListener('click', function () {
      showSlide(currentIndex - 1);
    });

    nextBtn.addEventListener('click', function () {
      showSlide(currentIndex + 1);
    });
  });
</script>

{% schema %}
{
  "name": "Testimonials Slider",
  "tag": "section",
  "class": "section-testimonials",
  "settings": [
    {
      "type": "header",
      "content": "Layout Constraints"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "min": 800,
      "max": 1600,
      "step": 10,
      "unit": "px",
      "label": "Max Container Width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Horizontal Padding (Inline)",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial Block",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote Text",
          "default": "Tempus oncu enim pellen tesque este pretium in neque, elit morbi sagittis lorem habi mattis Pellen tesque pretium feugiat vel morbi suspen dise sagittis lorem habi tasse morbi sagittis loreus oncu enim cursus."
        },
        {
          "type": "range",
          "id": "star_rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "label": "Star Rating",
          "default": 5
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Emma Chamberlin"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "category": "Custom sections",
      "blocks": [
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
            "author": "John Doe",
            "star_rating": 5
          }
        }
      ]
    }
  ]
}
{% endschema %}
